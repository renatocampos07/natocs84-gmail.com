def handle_excel(file):
    excel_file = pd.ExcelFile(file)
    sheet_names = excel_file.sheet_names

    invoices_cols = {
        "C100": "12",
        "C180": "8", 
        "D100": "15",
        "F100": "6"
    }

    supplier_cols = {
        "C100": "04",
        "C180": None,
        "D100": "04", 
        "F100": "03"
    }

    all_data = []

    for sheet in sheet_names:
        if sheet in invoices_cols:
        
            df = pd.read_excel(file, sheet_name=sheet)
            
        
            sheet_data = {
                'sheet_name': sheet,
                'id': df.iloc[:, 0], 
                'value': df.iloc[:, int(invoices_cols[sheet])] 
            }
            
        
            if supplier_cols[sheet] is not None:
                sheet_data['fornecedor'] = df.iloc[:, int(supplier_cols[sheet])]
            else:
                sheet_data['fornecedor'] = None
                
        
            sheet_df = pd.DataFrame(sheet_data)
            all_data.append(sheet_df)

    return pd.concat(all_data, ignore_index=True)

def generate_response(question, file):
    df = handle_excel(file)
    llm = ChatOpenAI(
        base_url="http://127.0.0.1:1234/v1/",
        temperature=0,
        api_key="not-needed"
    )

    output_parser = StrOutputParser()

    prompt = """ 
    CASO NAO INTERPRETE OS DADOS, RESPONDA "NÃO INTERPRETEI OS DADOS"
    Esses dados sao dados de declaração de dados fiscais e contabeis à receita federal do brasil;
    Com base nessas informações responda essas perguntas relacionadas ao SPED:

    {{question}}

    Retorne uma analise geral da sua interpretação dos dados e colunas para validação.

    {{NOTA}}
    """

    invoices_rows = ''
    for index, row in df.iterrows():
        invoices_rows += f"ID: {row['id']}, Valor: {row['value']}, Fornecedor: {row['fornecedor']}\n"
        
    PROMPT_TEMPLATE = ChatPromptTemplate(
        [
            ("system", prompt),
            ("human", "{input}"),
            ("human", "{question}"),
        ]
    )


    chain = PROMPT_TEMPLATE | llm | output_parser

    r = chain.invoke({"input": invoices_rows, 'question': question})
    return r

