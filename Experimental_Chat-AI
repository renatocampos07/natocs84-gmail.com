# Função para converter Excel para TXT
def convert_to_txt(filename):
    xls = pd.ExcelFile(filename)
    txt_filename = filename[:-5] + ".txt"
    rows = []

    for sheet_name in xls.sheet_names:
        df = xls.parse(sheet_name, dtype=str).fillna('')
        rows.extend(df.values.tolist())

    sorted_rows = sorted(rows, key=lambda x: (x[0].zfill(10), x[0]))
    
    with open(txt_filename, 'w', encoding='ISO-8859-1') as txt_file:
        for row in sorted_rows:
            txt_file.write("|" + "|".join(str(cell) for cell in row[1:-2]) + "|\n")

    return txt_filename

