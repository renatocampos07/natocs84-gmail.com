# Interface Gradio otimizada
def create_gradio_interface():
    with gr.Blocks() as demo:
        gr.Markdown("# SPED Analytics 📊")
        
        with gr.Tab("Conversor TXT→Excel"):
            gr.Markdown("### Converter arquivo SPED TXT para Excel")
            txt_input = gr.File(label="Arquivo TXT")
            chk_formula = gr.Checkbox(label="Incluir fórmulas de validação RFB")
            txt_button = gr.Button("Converter ▶️")
            txt_output = gr.File(label="Excel Gerado")
            txt_button.click(convert_to_excel, inputs=[txt_input, chk_formula], outputs=txt_output)
        
        with gr.Tab("Conversor Excel→TXT"):
            gr.Markdown("### Exportar para formato SPED oficial")
            excel_input = gr.File(label="Arquivo Excel")
            excel_button = gr.Button("Converter ▶️")
            excel_output = gr.File(label="TXT Gerado")
            excel_button.click(convert_to_txt, inputs=excel_input, outputs=excel_output)
        
        with gr.Tab("💡Análise Inteligente"):
            gr.Markdown("### Faça perguntas sobre os dados")
            file_input = gr.File(label="Carregue o Excel", type="binary")
            pergunta_input = gr.Textbox(label="Sua pergunta:", placeholder="Ex: Qual NF tem o maior valor?")
            resposta_output = gr.Markdown(label="Resposta:")
            pergunta_input.submit(generate_response, inputs=[pergunta_input, file_input], outputs=resposta_output)
    
    return demo

